#!/bin/bash
# Pre-Push Hook - Branch Enforcement + Completeness Review
# Part 1: Branch enforcement (BLOCKING)
# Part 2: Completeness review (NON-BLOCKING)

# Get project root
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Pre-Push: Branch Enforcement + Completeness"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

#================================
# PART 1: Branch Enforcement (BLOCKING)
#================================

# Detect which agent is pushing (three-agent architecture)
AGENT_ID="unknown"
AGENT_NAME="Unknown"

if [ -f ".claude/identity-cli-director.json" ]; then
    AGENT_ID="cli-claude-director-001"
    AGENT_NAME="CDIR"
elif [ -f ".claude/identity-cli-executor.json" ]; then
    AGENT_ID="cli-claude-executor-001"
    AGENT_NAME="CEXE"
elif [ -f ".claude/identity-web.json" ]; then
    AGENT_ID="web-claude-designer-001"
    AGENT_NAME="Web"
fi

echo "Pre-push: Agent $AGENT_NAME ($AGENT_ID)"
echo ""

echo "Part 1: Branch Convention Enforcement"
echo "--------------------------------------"
echo ""

# Read push details from stdin
while read local_ref local_sha remote_ref remote_sha; do
    # Extract branch name from ref
    if [[ $remote_ref =~ refs/heads/(.+)$ ]]; then
        branch="${BASH_REMATCH[1]}"

        # Block direct pushes to main or master
        if [[ "$branch" == "main" || "$branch" == "master" ]]; then
            echo "❌ ERROR: Direct push to $branch is not allowed!"
            echo ""
            echo "AI agents must use claude/* branch convention:"
            echo ""
            echo "  For CDIR (Designer-Researcher):"
            echo "    git checkout -b claude/design-description-\$(date +%s)"
            echo ""
            echo "  For CEXE (Executor-Validator):"
            echo "    git checkout -b claude/impl-description-\$(date +%s)"
            echo ""
            echo "  For Web (Standby-Emergency):"
            echo "    git checkout -b claude/web-emergency-reason-sessionid"
            echo ""
            echo "Then push to your branch:"
            echo "  git push -u origin <your-claude-branch>"
            echo ""
            echo "GitHub automation will:"
            echo "  1. Auto-create PR"
            echo "  2. Run validation tests"
            echo "  3. Auto-merge if passing"
            echo "  4. Delete branch after merge"
            echo ""
            echo "This prevents:"
            echo "  - Bypassing validation workflows"
            echo "  - Breaking main branch"
            echo "  - Losing PR audit trail"
            echo ""
            echo "See: docs/THREE_ENVIRONMENT_COORDINATION.md"
            echo "See: docs/LOCAL_AUTOMATION_STRATEGY.md"
            echo ""
            exit 1
        fi

        # Validate claude/* branch naming for three-agent architecture
        if [[ "$branch" == claude/* ]]; then
            # Check if branch pattern matches agent role
            if [ "$AGENT_ID" = "cli-claude-director-001" ]; then
                if [[ ! "$branch" =~ ^claude/design- ]]; then
                    echo "⚠️  WARNING: CDIR should use claude/design-* branches"
                    echo "   Current branch: $branch"
                    echo "   Expected: claude/design-*"
                    echo ""
                    echo "   Continuing anyway, but consider switching to correct pattern"
                    echo ""
                fi
            elif [ "$AGENT_ID" = "cli-claude-executor-001" ]; then
                if [[ ! "$branch" =~ ^claude/impl- ]]; then
                    echo "⚠️  WARNING: CEXE should use claude/impl-* branches"
                    echo "   Current branch: $branch"
                    echo "   Expected: claude/impl-*"
                    echo ""
                    echo "   Continuing anyway, but consider switching to correct pattern"
                    echo ""
                fi
            elif [ "$AGENT_ID" = "web-claude-designer-001" ]; then
                if [[ ! "$branch" =~ ^claude/web-emergency- ]]; then
                    echo "⚠️  WARNING: Web should use claude/web-emergency-* branches"
                    echo "   Current branch: $branch"
                    echo "   Expected: claude/web-emergency-*"
                    echo ""
                    echo "   Continuing anyway, but consider switching to correct pattern"
                    echo ""
                fi
            fi

            echo "✅ Valid claude branch: $branch"
        else
            echo "✅ Pushing to branch: $branch"
        fi
    fi
done

echo ""
echo "✅ Branch enforcement passed"
echo ""

#================================
# PART 2: Completeness Review (NON-BLOCKING)
#================================

set +e  # Don't exit on errors - this is advisory only

echo "Part 2: Completeness Review"
echo "----------------------------"
echo ""

# Check if completeness review script exists
if [ ! -f "tools/review-completeness.sh" ]; then
    echo "⚠️  Completeness review script not found"
    echo "   Skipping completeness check"
    echo ""
    exit 0
fi

# Run completeness review in non-interactive mode
echo "Running completeness review (non-blocking)..."
echo ""

COMPLETENESS_NON_INTERACTIVE=true bash tools/review-completeness.sh

COMPLETENESS_EXIT=$?

echo ""

if [ $COMPLETENESS_EXIT -eq 0 ]; then
    echo "✅ Completeness check passed"
elif [ $COMPLETENESS_EXIT -eq 1 ]; then
    echo "⚠️  Completeness check found issues"
    echo ""
    echo "   This is a WARNING, not a blocker."
    echo "   Push will proceed, but consider addressing issues."
    echo ""
    echo "   To review interactively, run:"
    echo "   ./tools/review-completeness.sh"
else
    echo "⚠️  Completeness check encountered an error"
    echo "   Push will proceed anyway"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Always exit 0 - we don't block pushes, just warn
exit 0
