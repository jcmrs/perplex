#!/bin/bash
# Pre-Commit Git Hook
# Enforces foundation validation before allowing commits

set -e

echo "=== Pre-Commit Validation ==="
echo ""

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# Detect which agent is committing (three-agent architecture)
AGENT_ID="unknown"
AGENT_NAME="Unknown"

if [ -f ".claude/identity-cli-director.json" ]; then
    AGENT_ID="cli-claude-director-001"
    AGENT_NAME="CDIR"
elif [ -f ".claude/identity-cli-executor.json" ]; then
    AGENT_ID="cli-claude-executor-001"
    AGENT_NAME="CEXE"
elif [ -f ".claude/identity-web.json" ]; then
    AGENT_ID="web-claude-designer-001"
    AGENT_NAME="Web"
fi

echo "Pre-commit: Agent $AGENT_NAME ($AGENT_ID)"
echo ""

# Run foundation validation
if [ -f "tools/validate-foundation.sh" ]; then
    echo "Running foundation validation..."
    bash tools/validate-foundation.sh

    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Foundation validation failed!"
        echo "   Fix issues before committing or use --no-verify to skip (not recommended)"
        exit 1
    fi
else
    echo "⚠️  Warning: tools/validate-foundation.sh not found"
    echo "   Skipping validation..."
fi

# Workspace boundary validation (three-agent architecture)
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Workspace Boundary Validation"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

MODIFIED_FILES=$(git diff --cached --name-only)
VIOLATIONS=()

for FILE in $MODIFIED_FILES; do
    # CDIR primary ownership
    if [ "$AGENT_ID" = "cli-claude-director-001" ]; then
        # CDIR should NOT directly modify implementation artifacts
        if [[ "$FILE" =~ ^src/ ]] || \
           [[ "$FILE" =~ ^tests/ ]] || \
           [[ "$FILE" =~ specs/.*/plan\.md$ ]] || \
           [[ "$FILE" =~ specs/.*/tasks\.md$ ]]; then
            VIOLATIONS+=("$FILE (CDIR should not modify implementation)")
        fi
    fi

    # CEXE primary ownership
    if [ "$AGENT_ID" = "cli-claude-executor-001" ]; then
        # CEXE should NOT directly modify design artifacts
        if [[ "$FILE" =~ ^decisions/ ]] || \
           [[ "$FILE" =~ ^requirements/ ]] || \
           [[ "$FILE" =~ specs/.*/spec\.md$ ]] || \
           [[ "$FILE" =~ \.specify/memory/constitution\.md$ ]]; then
            VIOLATIONS+=("$FILE (CEXE should not modify design)")
        fi
    fi

    # Web should only modify in emergency
    if [ "$AGENT_ID" = "web-claude-designer-001" ]; then
        # Check if emergency branch
        CURRENT_BRANCH=$(git branch --show-current)
        if [[ ! "$CURRENT_BRANCH" =~ ^claude/web-emergency- ]]; then
            VIOLATIONS+=("$FILE (Web not on emergency branch)")
        fi
    fi
done

if [ ${#VIOLATIONS[@]} -gt 0 ]; then
    echo "❌ Workspace boundary violations detected:"
    for VIOLATION in "${VIOLATIONS[@]}"; do
        echo "  - $VIOLATION"
    done
    echo ""
    echo "Check .claude/workspace-coordination.yml for agent boundaries"
    echo "To override (NOT recommended): git commit --no-verify"
    exit 1
fi

echo "✓ Workspace boundaries validated"
echo ""

# Run workspace boundary validation (legacy script if exists)
if [ -f "tools/validate-workspace-boundaries.sh" ]; then
    echo "Running legacy workspace validation..."
    echo ""

    # Get staged files
    STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

    if [ -z "$STAGED_FILES" ]; then
        echo "No files staged for commit"
    else
        VIOLATIONS=()

        for file in $STAGED_FILES; do
            # Run validation
            if ! bash tools/validate-workspace-boundaries.sh --file "$file" --quiet 2>&1; then
                EXIT_CODE=$?

                if [ $EXIT_CODE -eq 2 ]; then
                    # Emergency override detected
                    echo "⚠️  Emergency override for: $file"
                elif [ $EXIT_CODE -eq 1 ]; then
                    # Boundary violation
                    VIOLATIONS+=("$file")
                fi
            fi
        done

        if [ ${#VIOLATIONS[@]} -gt 0 ]; then
            echo ""
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "❌ Workspace Boundary Violations Detected"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo ""
            echo "The following files violate workspace boundaries:"
            echo ""
            for file in "${VIOLATIONS[@]}"; do
                echo "  ❌ $file"
            done
            echo ""
            echo "Run for details:"
            echo "  bash tools/validate-workspace-boundaries.sh --file <path>"
            echo ""
            echo "Options:"
            echo "  1. Remove violating files from commit:"
            echo "     git restore --staged <file>"
            echo ""
            echo "  2. Emergency override (document reason):"
            echo "     git commit -m \"[EMERGENCY] Reason for override...\""
            echo ""
            echo "  3. Skip validation (not recommended):"
            echo "     git commit --no-verify"
            echo ""
            echo "See: docs/AGENT_WORKSPACE_COORDINATION.md"
            echo ""
            exit 1
        fi

        echo "✅ All files respect workspace boundaries"
    fi
else
    echo "⚠️  Warning: tools/validate-workspace-boundaries.sh not found"
    echo "   Skipping workspace validation..."
fi

echo ""
echo "✅ Pre-commit validation passed"
echo ""

exit 0
