# Project Perplex - Git Ignore

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.settings/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary Files
*.tmp
*.temp
.tmp/
.temp/

# Environment Variables
.env
.env.local
.env.*.local

# Dependencies (if we add them)
node_modules/
vendor/
__pycache__/
*.py[cod]
*$py.class

# Build Outputs
dist/
build/
*.egg-info/
.pytest_cache/

# Personal Notes (not for repo)
.notes/
PRIVATE.md
scratch/

# Session-Specific (ephemeral)
.session-temp/

# Secrets & Credentials
*secret*
*credential*
*.key
*.pem
*.p12

# Exclude large binaries
*.zip
*.tar.gz
*.rar

# But keep empty directory markers
!.gitkeep

# Allow example configs
!*.example.*
!*example.*

# Project-specific additions
# (Add more as project evolves)
